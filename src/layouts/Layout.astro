---
import '../styles/global.css';
const { title = 'Han Che — Research & software', description = 'Han Che studies Data Science and Big Data Technology at Xi’an Jiaotong-Liverpool University. Selected work in atmospheric data, machine learning and research software.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [['Research','/research/'],['Projects','/projects/'],['About','/about/'],['Photography','/photography/']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f2f4f2"/><title>{title}</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="canonical" href={new URL(path,Astro.site)}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={new URL(path,Astro.site)}/><meta property="og:image" content="https://koreyoshie.github.io/art/atmosphere.svg"/><link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin/><link rel="sitemap" href="/sitemap.xml"/>
</head><body><a class="skip" href="#main">Skip to content</a><header class="site-header wrap"><a class="wordmark" href="/" aria-label="Han Che, home">Han Che<span class="wordmark-dot" aria-hidden="true"></span></a><nav class="desktop-nav" aria-label="Main navigation">{nav.map(([label,url])=><a href={url} aria-current={path.startsWith(url)?'page':undefined}>{label}</a>)}</nav><a class="header-github" href="https://github.com/KoreyoshiE">GitHub <span aria-hidden="true">↗</span></a><details class="mobile-nav"><summary>Menu <span aria-hidden="true">+</span></summary><nav aria-label="Mobile navigation">{nav.map(([label,url])=><a href={url} aria-current={path.startsWith(url)?'page':undefined}>{label}</a>)}<a href="/contact/">Contact</a></nav></details></header><main id="main"><slot /></main><footer class="site-footer wrap"><div class="footer-top"><p>Good questions deserve<br/>a conversation.</p><a class="text-link" href="/contact/">Get in touch <span aria-hidden="true">↗</span></a></div><div class="footer-bottom"><a href="/">Han Che</a><span>Research, software & ways of seeing.</span><a href="https://github.com/KoreyoshiE">GitHub ↗</a><span>© {new Date().getFullYear()}</span></div></footer><script>import '../scripts/site';</script></body></html>
