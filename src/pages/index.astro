---
import Layout from "../layouts/Layout.astro";
import Flow from "../components/Flow.astro";
import Arrow from "../components/Arrow.astro";
import OzoneChart from "../components/OzoneChart.astro";
import Pipeline from "../components/Pipeline.astro";
---

<Layout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="intro-note">
        <span class="status-dot" aria-hidden="true"></span>Data science
        undergraduate
      </p>
      <h1 id="hero-title">
        <span>Han Che</span>
      </h1>
      <p class="hero-statement">
        Observing carefully.
        <br />
        Building deliberately.
      </p>
      <div class="hero-bottom">
        <p>
          I study atmospheric data and machine learning, and build software that
          makes the work traceable.
        </p>
        <a
          class="round-link"
          href="#selected"
          aria-label="Explore selected research"
        >
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
    <Flow class="hero-art" />
  </section>
  <div class="hero-foot wrap">
    <span>Xi’an Jiaotong-Liverpool University</span>
    <span>Research & software / Selected work</span>
    <span aria-hidden="true">Scroll to explore ↓</span>
  </div>
  <section class="section wrap" id="selected" aria-labelledby="research-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">A closer look</p>
        <h2 id="research-title">
          From observations
          <br />
          to understanding.
        </h2>
      </div>
      <p>
        My research interests start with the data: where it comes from, how it
        is evaluated, and what it can actually tell us.
      </p>
    </div>
    <article class="feature feature-wdcgg">
      <a class="visual-link" href="/research/wdcgg/">
        <Pipeline />
      </a>
      <div class="feature-copy">
        <p class="project-type">Research software / Atmospheric observations</p>
        <h3>
          <a href="/research/wdcgg/">
            The work before
            <br />
            the conclusion.
          </a>
        </h3>
        <p>
          A reproducible pipeline for long-term CO₂ and CH₄ observations. Source
          identity, quality control and completeness come before environmental
          interpretation.
        </p>
        <a class="text-link" href="/research/wdcgg/">
          WDCGG Data Pipeline <Arrow />
        </a>
        <small>Manuscript under peer-review revision</small>
      </div>
    </article>
    <article class="feature feature-ozone">
      <div class="feature-copy">
        <p class="project-type">Machine learning / Atmospheric science</p>
        <h3>
          <a href="/research/shanghai-ozone/">
            A model is only
            <br />
            part of the story.
          </a>
        </h3>
        <p>
          Weather typing and out-of-year ozone prediction in Shanghai, with
          particular attention to where a circulation catalogue stops being
          representative.
        </p>
        <a class="text-link" href="/research/shanghai-ozone/">
          Shanghai Ozone ML <Arrow />
        </a>
        <small>SURF-2026-0008 / Undergraduate research</small>
      </div>
      <OzoneChart />
    </article>
    <a class="text-link section-more" href="/research/">
      Explore the research <Arrow />
    </a>
  </section>
  <section class="software-band">
    <div class="wrap section">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Selected software</p>
          <h2>Ideas, made executable.</h2>
        </div>
        <a class="text-link" href="/projects/">
          Project index <Arrow />
        </a>
      </div>
      <a class="project-row" href="/projects/agent-router/">
        <span class="project-domain">Language models</span>
        <h3>Choosing the right tool.</h3>
        <span>Qwen3 prompt baselines</span>
        <Arrow />
      </a>
      <a class="project-row" href="/projects/omnistream/">
        <span class="project-domain">Data systems</span>
        <h3>A structure for the stream.</h3>
        <span>PostgreSQL coursework</span>
        <Arrow />
      </a>
    </div>
  </section>
  <section class="about-preview wrap section">
    <p class="section-kicker">Beyond the model</p>
    <h2>Attention is a practice.</h2>
    <div>
      <p class="large-body">
        In research, I’m interested in the decisions behind a result. In
        photography, it’s the decisions behind a frame.
      </p>
      <p>
        I’m an undergraduate in Data Science and Big Data Technology at Xi’an
        Jiaotong-Liverpool University, interested in reproducible research,
        computational methods and visual storytelling.
      </p>
      <a class="text-link" href="/about/">
        A little about me <Arrow />
      </a>
    </div>
    <a class="photo-note" href="/photography/">
      <span class="frame-corners" aria-hidden="true"></span>
      <span>Ways of seeing</span>
      <small>A space for future photographic work</small>
      <Arrow />
    </a>
  </section>
</Layout>
